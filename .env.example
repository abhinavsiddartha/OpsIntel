# OpsIntel Environment Configuration

# Backend Configuration
ENVIRONMENT=development
PROJECT_NAME="OpsIntel - AI Business Operations Intelligence Platform"
API_V1_STR=/api/v1
SECRET_KEY=opsintel-super-secret-production-grade-key-change-in-prod-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# Default: SQLite for immediate zero-config local run
DATABASE_URL=sqlite:///./opsintel.db
# PostgreSQL option:
# DATABASE_URL=postgresql://opsintel_user:opsintel_password@localhost:5432/opsintel_db

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Engine Configuration
AI_ENGINE_MODE=hybrid # hybrid, offline, or openai/gemini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Seed Data Configuration
SEED_DATA_SIZE=medium # small, medium, large

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="OpsIntel"
